{
    "name": "diephp/telegraph",
    "description": "Focused Laravel Telegram integration for Restsify notifications and bot callbacks",
    "keywords": [
        "telegram",
        "laravel",
        "telegraph"
    ],
    "homepage": "https://github.com/diephp/telegraph",
    "license": "MIT",
    "authors": [
        {
            "name": "Fabio Ivona",
            "email": "fabio.ivona@defstudio.it",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.15.2",
        "guzzlehttp/psr7": "^2.12.3",
        "illuminate/contracts": "^12.69 | ^13.30",
        "illuminate/database": "^12.69 | ^13.30",
        "illuminate/http": "^12.69 | ^13.30",
        "illuminate/support": "^12.69 | ^13.30"
    },
    "require-dev": {
        "ext-sqlite3": "*",
        "defstudio/pest-plugin-laravel-expectations": "^2.6.2",
        "friendsofphp/php-cs-fixer": "^3.94",
        "larastan/larastan": "^3.14",
        "orchestra/testbench": "^10.9 | ^11.3",
        "pestphp/pest": "^4.4.1",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0.1",
        "phpstan/phpstan-phpunit": "^2.0.4",
        "spatie/pest-plugin-snapshots": "^2.1.0"
    },
    "conflict": {
        "defstudio/telegraph": "*",
        "symfony/http-foundation": "<7.4.23 || >=8.0,<8.1.11"
    },
    "support": {
        "issues": "https://github.com/diephp/telegraph/issues",
        "source": "https://github.com/diephp/telegraph"
    },
    "autoload": {
        "psr-4": {
            "DefStudio\\Telegraph\\": "src",
            "DefStudio\\Telegraph\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DefStudio\\Telegraph\\Tests\\": "tests"
        }
    },
    "scripts": {
        "lint": "@php vendor/bin/php-cs-fixer fix -v",
        "test:lint": "@php vendor/bin/php-cs-fixer fix -v --dry-run --diff",
        "test:types": "vendor/bin/phpstan analyse --ansi --memory-limit=-1",
        "test:unit": "@php vendor/bin/pest --colors=always --no-coverage",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ],
        "update:snapshots": "vendor/bin/pest --colors=always -d --update-snapshots",
        "coverage": "@php vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DefStudio\\Telegraph\\TelegraphServiceProvider"
            ],
            "aliases": {
                "Telegraph": "DefStudio\\Telegraph\\Facades\\Telegraph"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
